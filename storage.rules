rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() { return request.auth != null && request.auth.token.role == 'admin'; }
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Everyone can view product and blog images; only admins can upload or delete them.
    match /products/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }
    match /blogs/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
